# 서버
RIBBON_HOST=0.0.0.0
RIBBON_PORT=8765

# 제공자 선택: mock 으로 두면 모델 없이 전체 흐름이 돌아감
RIBBON_STT_PROVIDER=mock            # mock | faster_whisper | mlx_whisper (맥미니)
RIBBON_LLM_PROVIDER=mock            # mock | openai
RIBBON_TTS_PROVIDER=browser         # browser | mac_say
RIBBON_WAKEWORD_PROVIDER=mock       # mock | openwakeword

# LLM (Ollama 또는 mlx-lm 서버, OpenAI 호환 엔드포인트)
RIBBON_LLM_BASE_URL=http://localhost:11434/v1
RIBBON_LLM_MODEL=qwen3:30b-a3b
RIBBON_LLM_API_KEY=ollama
RIBBON_LLM_MAX_TOKENS=400
RIBBON_LLM_NO_THINK=true            # qwen3 생각 모드 끄기 (답이 비면 이게 꺼져 있는지 확인)

# STT
RIBBON_STT_MODEL=large-v3-turbo     # mlx_whisper 면 mlx-community/whisper-large-v3-turbo 로 해석됨

# 호출어
RIBBON_WAKE_PHRASE=리본아
RIBBON_WAKEWORD_MODEL_PATH=
RIBBON_WAKEWORD_THRESHOLD=0.5

# 오디오
RIBBON_CHANNELS=4
RIBBON_SAMPLE_RATE=16000
RIBBON_VAD_SILENCE_MS=800
RIBBON_MAX_UTTERANCE_S=15
RIBBON_FOLLOW_UP_WINDOW_S=6

# 대기열
RIBBON_WAITING_TIMEOUT_S=20
RIBBON_TURN_IDLE_TIMEOUT_S=10

# 데이터
RIBBON_KIDS_FILE=../data/kids.json
